// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Pulse v3 — indicador de los sistemas VALIDADOS del laboratorio (2026-07-20)
// Diseñado para QQQ en gráfico de 1 MINUTO (los sistemas derivan sus bloques 5-min igual que el loop).
// LIVE: S2 FVG · S1 RSI2 · S3 VWAPPB · S4 SWP  |  SHADOW: S6 SWPS (short) · GT diarias (o2c)
// Los GATES diarios (rvol30, xvwap60, open≥VAL) son parte del sistema: señal sin gate NO es señal.

//@version=6
indicator("Pulse v3 — QQQ Systems", overlay=true, max_labels_count=500, max_boxes_count=100)

// ══════════════════ INPUTS ══════════════════
showFVG    = input.bool(true,  "S2 FVG (LIVE)",            group="Sistemas LIVE")
showRSI2   = input.bool(true,  "S1 RSI2 5m (LIVE)",        group="Sistemas LIVE")
showVWAPPB = input.bool(true,  "S3 VWAP Pullback (LIVE)",  group="Sistemas LIVE")
showSWP    = input.bool(true,  "S4 Sweep&Reclaim (LIVE)",  group="Sistemas LIVE")
showSWPS   = input.bool(true,  "S6 Sweep-Short (SHADOW)",  group="Shadows")
showGT     = input.bool(true,  "GT diarias (SHADOW o2c)",  group="Shadows")
showDash   = input.bool(true,  "Dashboard",                 group="Visual")
showVwapLn = input.bool(true,  "Línea VWAP",                group="Visual")
showLevels = input.bool(true,  "SL/TP de la última señal",  group="Visual")
rvolMin    = input.float(0.85, "Gate FVG: rvol30 mínimo",   group="Gates (spec v3)", step=0.05)
xvwapMin   = input.int(6,      "Gate VWAPPB: cruces VWAP 1ª hora", group="Gates (spec v3)")
volMult    = input.float(1.5,  "SWP/SWPS: vol ≥ × avg5",    group="Gates (spec v3)", step=0.1)

// ══════════════════ SESIÓN Y VWAP ══════════════════
inSession  = not na(time(timeframe.period, "0930-1600", "America/New_York"))
first30    = not na(time(timeframe.period, "0930-1000", "America/New_York"))
firstHour  = not na(time(timeframe.period, "0930-1030", "America/New_York"))
newSession = inSession and not inSession[1]

var float vwapPV  = 0.0
var float vwapV   = 0.0
var float sessLow  = na
var float sessHigh = na
var float sessOpen = na
if newSession
    vwapPV := 0.0
    vwapV  := 0.0
    sessLow  := low
    sessHigh := high
    sessOpen := open
if inSession
    vwapPV += hlc3 * volume
    vwapV  += volume
    sessLow  := math.min(nz(sessLow, low), low)
    sessHigh := math.max(nz(sessHigh, high), high)
vwap = vwapV > 0 ? vwapPV / vwapV : hlc3
plot(showVwapLn and inSession ? vwap : na, "VWAP", color=color.new(color.white, 30), linewidth=2)

// ══════════════════ NIVELES DE AYER (VAL aprox = vwap − 0.34×rango) ══════════════════
var float yVwap = na
var float yHigh = na
var float yLow  = na
var float yClose = na
var float curVwap = na
if inSession
    curVwap := vwap
if not inSession and inSession[1]                      // cierre de sesión
    yVwap  := curVwap[1]
    yHigh  := sessHigh
    yLow   := sessLow
    yClose := close[1]
yVAL = na(yVwap) ? na : yVwap - 0.34 * (yHigh - yLow)
yVAH = na(yVwap) ? na : yVwap + 0.34 * (yHigh - yLow)

// ══════════════════ GATES DIARIOS (spec v3: se fijan 10:00 / 10:30) ══════════════════
var float vol30Today = 0.0
var float[] vol30Hist = array.new_float(0)             // primeras-30min de días previos
var float rvol30   = na
var int   xvwapCnt = 0
var bool  fvgOn    = false
var bool  rsi2On   = false
var bool  vwappbOn = false
if newSession
    vol30Today := 0.0
    xvwapCnt := 0
    rvol30 := na
    fvgOn := false
    vwappbOn := false
    rsi2On := not na(yVAL) and open >= yVAL            // gate S1: open ≥ VAL ayer
if first30
    vol30Today += volume
if firstHour and inSession and vwapV > 0
    if math.sign(close - vwap) != math.sign(close[1] - vwap[1]) and not na(close[1])
        xvwapCnt += 1
// fija rvol30 al terminar la ventana 9:30-10:00
if not first30 and first30[1]
    if array.size(vol30Hist) >= 3
        rvol30 := vol30Today / array.avg(vol30Hist)
        fvgOn  := rvol30 >= rvolMin
    array.push(vol30Hist, vol30Today)
    if array.size(vol30Hist) > 5
        array.shift(vol30Hist)
// fija vwappb_on al terminar la 1ª hora
if not firstHour and firstHour[1]
    vwappbOn := xvwapCnt >= xvwapMin

// ══════════════════ 5-MIN DERIVADO (RSI2 + ATR14, solo bloques sellados) ══════════════════
[rsi2_5m, atr_5m] = request.security(syminfo.tickerid, "5", [ta.rsi(close, 2), ta.atr(14)], lookahead=barmerge.lookahead_off)
newBlock = ta.change(time("5")) != 0                   // 1ª barra 1-min de un bloque nuevo
rsi2Sealed = rsi2_5m[1]                                 // valor del bloque recién SELLADO
atrSealed  = atr_5m[1]
atr1m      = ta.atr(14)
rsi14_1m   = ta.rsi(close, 14)
volAvg5    = ta.sma(volume, 5)

// niveles de la última señal (para plot)
var float sigSL = na
var float sigTP = na
var int   sigBar = na

// ══════════════════ S1 RSI2 (LIVE) — RSI2(5m) < 15 al sellar bloque ══════════════════
s1Signal = showRSI2 and inSession and newBlock and rsi2On and not na(rsi2Sealed) and rsi2Sealed < 15 and not na(atrSealed)
if s1Signal
    e = close[1]
    sigSL := e - 1.0 * atrSealed
    sigTP := e + 0.5 * atrSealed
    sigBar := bar_index
    label.new(bar_index, low, "S1\nRSI2=" + str.tostring(math.round(rsi2Sealed, 1)), style=label.style_label_up, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)
    alert("PULSE S1 RSI2 LONG | entry:" + str.tostring(math.round(e, 2)) + " SL:" + str.tostring(math.round(sigSL, 2)) + " TP:" + str.tostring(math.round(sigTP, 2)) + " ts15min", alert.freq_once_per_bar)

// ══════════════════ S2 FVG (LIVE) — hueco alcista 3 barras, gate rvol30 ══════════════════
fvgFormed = showFVG and inSession and low > high[2] and fvgOn and barstate.isconfirmed
if fvgFormed
    mid = (high[2] + low) / 2
    box.new(bar_index - 2, low, bar_index + 20, high[2], border_color=color.new(color.aqua, 40), bgcolor=color.new(color.aqua, 88))
    line.new(bar_index - 2, mid, bar_index + 20, mid, color=color.new(color.aqua, 20), style=line.style_dashed)
    sigSL := low[2] - 0.02
    sigTP := mid + 2 * (mid - sigSL)
    sigBar := bar_index
    label.new(bar_index, high, "S2 FVG\nmid " + str.tostring(math.round(mid, 2)), style=label.style_label_down, color=color.new(color.aqua, 20), textcolor=color.black, size=size.small)
    alert("PULSE S2 FVG | limit:" + str.tostring(math.round(mid, 2)) + " SL:" + str.tostring(math.round(sigSL, 2)) + " TP:" + str.tostring(math.round(sigTP, 2)), alert.freq_once_per_bar)

// ══════════════════ S3 VWAPPB (LIVE) — pullback a VWAP, 5 condiciones + gate choppy ══════════════════
s3Cond = close > vwap and low <= vwap * 1.001 and volume < volume[1] and volume[1] < volume[2] and close > open and rsi14_1m >= 45 and rsi14_1m <= 65 and low > sessLow
s3Signal = showVWAPPB and inSession and vwappbOn and s3Cond and barstate.isconfirmed
if s3Signal
    sigSL := close - 2 * atr1m
    sigTP := close + 2 * atr1m
    sigBar := bar_index
    label.new(bar_index, low, "S3\nVWAPPB", style=label.style_label_up, color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
    alert("PULSE S3 VWAPPB LONG | entry:" + str.tostring(math.round(close, 2)) + " SL:" + str.tostring(math.round(sigSL, 2)) + " TP:" + str.tostring(math.round(sigTP, 2)), alert.freq_once_per_bar)

// ══════════════════ S4 SWP (LIVE) + S6 SWPS (SHADOW short) — sweep + reclaim/rechazo ══════════════════
var float sweptLowLvl  = na
var int   sweptLowBar  = na
var float sweptHighLvl = na
var int   sweptHighBar = na
prevSessLow  = inSession and low  == sessLow  and not na(sessLow[1])  and low  < sessLow[1]  ? sessLow[1]  : na
prevSessHigh = inSession and high == sessHigh and not na(sessHigh[1]) and high > sessHigh[1] ? sessHigh[1] : na
if not na(prevSessLow)
    sweptLowLvl := prevSessLow
    sweptLowBar := bar_index
if not na(prevSessHigh)
    sweptHighLvl := prevSessHigh
    sweptHighBar := bar_index

s4Signal = showSWP and inSession and barstate.isconfirmed and not na(sweptLowLvl) and bar_index - sweptLowBar <= 3 and bar_index > sweptLowBar and close > sweptLowLvl and close > open and volume >= volMult * volAvg5
if s4Signal
    sigSL := sessLow - 0.05
    sigTP := close + 0.5 * (close - sigSL)
    sigBar := bar_index
    label.new(bar_index, low, "S4\nSWP", style=label.style_label_up, color=color.new(color.lime, 20), textcolor=color.black, size=size.small)
    alert("PULSE S4 SWP LONG | entry:" + str.tostring(math.round(close, 2)) + " SL:" + str.tostring(math.round(sigSL, 2)) + " TP:" + str.tostring(math.round(sigTP, 2)), alert.freq_once_per_bar)
    sweptLowLvl := na

s6Signal = showSWPS and inSession and barstate.isconfirmed and not na(sweptHighLvl) and bar_index - sweptHighBar <= 3 and bar_index > sweptHighBar and close < sweptHighLvl and close < open and volume >= volMult * volAvg5
if s6Signal
    s6sl = sessHigh + 0.05
    s6tp = close - 0.5 * (s6sl - close)
    label.new(bar_index, high, "S6 sh\nSWPS", style=label.style_label_down, color=color.new(color.red, 30), textcolor=color.white, size=size.small)
    alert("PULSE S6 SWPS SHORT (SHADOW) | entry:" + str.tostring(math.round(close, 2)) + " SL:" + str.tostring(math.round(s6sl, 2)) + " TP:" + str.tostring(math.round(s6tp, 2)), alert.freq_once_per_bar)
    sweptHighLvl := na

// ══════════════════ GT DIARIAS (SHADOW o2c) — señal con datos de AYER, vigente TODO el día ══════════════════
[dC1, dO1, dH1, dL1, dRsi2, dC2] = request.security(syminfo.tickerid, "D", [close[1], open[1], high[1], low[1], ta.rsi(close, 2)[1], close[2]], lookahead=barmerge.lookahead_off)
var int consecDn = 0
if ta.change(time("D")) != 0
    consecDn := not na(dC1) and not na(dC2) and dC1 < dC2 ? consecDn + 1 : 0
dRng   = dH1 - dL1
dClr   = dRng > 0 ? (dC1 - dL1) / dRng : 0.5
gtR2d  = dRsi2 < 5
gtD3   = consecDn >= 3
gtWsh  = dRsi2 < 10 and dClr < 0.3
gtCl   = dClr < 0.2 and dC1 < dO1
gtAny  = showGT and (gtR2d or gtD3 or gtWsh or gtCl)
bgcolor(gtAny and inSession ? color.new(color.purple, 92) : na, title="GT día activo")
if gtAny and newSession
    gtTxt = (gtR2d ? "RSI2d " : "") + (gtD3 ? "3DN " : "") + (gtWsh ? "WSH " : "") + (gtCl ? "CLW" : "")
    label.new(bar_index, high, "GT o2c: " + gtTxt, style=label.style_label_down, color=color.new(color.purple, 20), textcolor=color.white, size=size.normal)
    alert("PULSE GT SHADOW o2c | " + gtTxt + " | long open->close hoy", alert.freq_once_per_bar)

// ══════════════════ NIVELES DE LA ÚLTIMA SEÑAL ══════════════════
plot(showLevels and not na(sigBar) and bar_index - sigBar < 30 ? sigSL : na, "SL señal", color=color.new(color.red, 40),   style=plot.style_linebr, linewidth=1)
plot(showLevels and not na(sigBar) and bar_index - sigBar < 30 ? sigTP : na, "TP señal", color=color.new(color.green, 40), style=plot.style_linebr, linewidth=1)

// ══════════════════ DASHBOARD ══════════════════
var table dash = table.new(position.bottom_right, 2, 8, bgcolor=color.rgb(10, 10, 30, 15), border_width=1)
if showDash and barstate.islast
    okC  = color.green
    offC = color.gray
    badC = color.red
    table.cell(dash, 0, 0, "PULSE v3",  text_color=color.white, bgcolor=color.rgb(40, 40, 80), text_size=size.small)
    table.cell(dash, 1, 0, inSession ? "SESIÓN" : "CERRADO", text_color=inSession ? okC : offC, bgcolor=color.rgb(40, 40, 80), text_size=size.small)
    table.cell(dash, 0, 1, "rvol30 (S2)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, na(rvol30) ? "—" : str.tostring(math.round(rvol30, 2)) + (fvgOn ? " ✓" : " ✗"), text_color=fvgOn ? okC : badC, text_size=size.small)
    table.cell(dash, 0, 2, "xvwap60 (S3)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(xvwapCnt) + (vwappbOn ? " ✓" : " ✗"), text_color=vwappbOn ? okC : badC, text_size=size.small)
    table.cell(dash, 0, 3, "open≥VAL (S1)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, rsi2On ? "✓" : "✗", text_color=rsi2On ? okC : badC, text_size=size.small)
    table.cell(dash, 0, 4, "RSI2 5m", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, na(rsi2Sealed) ? "—" : str.tostring(math.round(rsi2Sealed, 1)), text_color=not na(rsi2Sealed) and rsi2Sealed < 15 ? okC : color.silver, text_size=size.small)
    table.cell(dash, 0, 5, "GT hoy", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, gtAny ? "ACTIVO" : "—", text_color=gtAny ? color.purple : offC, text_size=size.small)
    table.cell(dash, 0, 6, "VAL ayer", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, na(yVAL) ? "—" : str.tostring(math.round(yVAL, 2)), text_color=color.silver, text_size=size.small)
    table.cell(dash, 0, 7, "Rango sesión", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, na(sessLow) ? "—" : str.tostring(math.round(sessLow, 2)) + "–" + str.tostring(math.round(sessHigh, 2)), text_color=color.silver, text_size=size.small)
